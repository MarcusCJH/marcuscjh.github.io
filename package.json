{
  "name": "marcus-chan-portfolio",
  "version": "3.0.0",
  "description": "Modern portfolio website for Marcus Chan - Lead Full Stack Engineer & Cloud Architect. Built with Vite, featuring responsive design, interactive timeline, and project showcase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "node -r ./scripts/eslint-ts6.cjs ./node_modules/eslint/bin/eslint.js src plugins --fix",
    "lint:check": "node -r ./scripts/eslint-ts6.cjs ./node_modules/eslint/bin/eslint.js src plugins",
    "format": "prettier --write src plugins",
    "format:check": "prettier --check src plugins",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pre-commit": "npm run lint && npm run format && npx tsc --noEmit && npm run test:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusCJH/marcuscjh.github.io.git"
  },
  "keywords": [
    "portfolio",
    "website",
    "vite",
    "typescript",
    "javascript",
    "css",
    "html",
    "responsive",
    "modern",
    "github-pages",
    "full-stack",
    "cloud-architect",
    "developer"
  ],
  "author": {
    "name": "Marcus Chan",
    "email": "marcuschanjh@gmail.com",
    "url": "https://marcuscjh.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MarcusCJH/marcuscjh.github.io/issues"
  },
  "homepage": "https://marcuscjh.com",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.6.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "typescript-6": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
