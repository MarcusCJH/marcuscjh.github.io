# Pinned workaround, not a preference. typescript-eslint 8.72.1 peers on
# typescript ">=4.8.4 <6.1.0" but the root project is on TypeScript 7.0.2, so a plain
# `npm install` fails with ERESOLVE ("Conflicting peer dependency: typescript@6.0.3").
# Remove once typescript-eslint supports TypeScript >= 7.1. See scripts/eslint-ts6.cjs,
# which documents the matching lint-time workaround (and eslint.config.mjs,
# which must stay native ESM for that shim to apply).
legacy-peer-deps=true
